09648,0.02648481,-0.00655531,0.07262053,-0.00446896,0.05385861,-0.02669667,0.22155473,0.04673762,-0.01574795,0.00973198,-0.01012681,0.09648357,0.01131735,0.0052113,-0.0130004,-0.02814401,0.06080256,-0.04461324,-0.0032022,0.01459613,-0.0134077,-0.01045698,0.0288924,-0.0141825,-0.09750507,0.03330902,-0.06235993,0.01070912,0.11503954,0.03295759,-0.01926509,0.01522681,0.00605437,0.06455164,-0.08320559,-0.01603868,-0.07666367,0.01815012,-0.04727423,0.06498475,0.03759933,-0.0599837,-0.06737056,-0.0155878,0.03214055,-0.00415755,-0.0142157,0.05345966,0.03727419],"last_embed":{"tokens":67,"hash":"6a8gwi"}}},"last_read":{"hash":"6a8gwi","at":1778921893977},"class_name":"SmartSource","last_import":{"at":0,"hash":null,"mtime":0,"size":0},"blocks":{"#---frontmatter---":[1,8],"#人魚":[9,34],"#人魚#{1}":[10,15],"#人魚#簡介":[16,17],"#人魚#特徵":[18,20],"#人魚#特徵#{1}":[19,20],"#人魚#政治":[21,29],"#人魚#政治#{1}":[22,22],"#人魚#政治#{2}":[23,23],"#人魚#政治#{3}":[24,24],"#人魚#政治#{4}":[25,25],"#人魚#政治#{5}":[26,26],"#人魚#政治#{6}":[27,27],"#人魚#政治#{7}":[28,29],"#人魚#歷史":[30,34],"#人魚#歷史#{1}":[31,34]},"outlinks":[{"title":"阿奎斯托","target":"阿奎斯托","line":13},{"title":"北太平洋王國","target":"北太平洋王國","line":23},{"title":"南太平洋王國","target":"南太平洋王國","line":24},{"title":"北冰洋王國","target":"北冰洋王國","line":25},{"title":"北大西洋王國","target":"北大西洋王國","line":26},{"title":"南。雖然這七個人魚王國名義上是聯盟，但實際關係並不和諧，近200年因為的堀起，逐漸分化為改革派與保守派。\n雖然人魚王國以公主為國家元首，但公主對國家行政幾乎沒有影響力，只負責主持典禮、授予榮譽稱號及任命或罷免大長老。儘管法制上公主有否決大長老的任命並要求重新進行選舉的權力，但因為公主完全受制於長老團，所以該法規實際上形同虛設。人魚王國的一切權力皆掌握在大長老手中，大長老由長老團選出，沒有任期，擁有任命與罷免官員的權力。長老團負責監督大長老行使其職權，若長老團認為大長老嚴重失職，可在內部通過彈劾議案後奏請公主罷免大長老。此外，長老團還負責維護[[原初大法術．星降神臨","target":"南。雖然這七個人魚王國名義上是聯盟，但實際關係並不和諧，近200年因為的堀起，逐漸分化為改革派與保守派。\n雖然人魚王國以公主為國家元首，但公主對國家行政幾乎沒有影響力，只負責主持典禮、授予榮譽稱號及任命或罷免大長老。儘管法制上公主有否決大長老的任命並要求重新進行選舉的權力，但因為公主完全受制於長老團，所以該法規實際上形同虛設。人魚王國的一切權力皆掌握在大長老手中，大長老由長老團選出，沒有任期，擁有任命與罷免官員的權力。長老團負責監督大長老行使其職權，若長老團認為大長老嚴重失職，可在內部通過彈劾議案後奏請公主罷免大長老。此外，長老團還負責維護[[原初大法術．星降神臨","line":27}],"metadata":{"type":"species","id":"species_mermaid","name_en":"mermaid","branch":true,"ex