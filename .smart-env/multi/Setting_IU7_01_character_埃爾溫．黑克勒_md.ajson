adata":{"type":"character","id":"erwin_001","importance":"normal","name_en":"Erwin Heckler","entity_type":"outsider","alive":true,"ranger":false,"military":false,"have_combat_eq":false,"process_srune":false},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Setting/IU7/01_character/埃爾溫．黑克勒.md##相對合理存在": {"path":null,"last_embed":{"hash":"1gq0ufh","at":1778668452643},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.05908734,-0.0129982,0.06236295,-0.04773651,-0.03728572,0.03429451,0.00248818,-0.02433528,0.05392271,0.00055473,0.02368084,-0.07115231,0.05332076,0.04885047,0.02404006,-0.00752152,0.02340036,-0.04441044,-0.04689429,0.012526,0.13317005,-0.0594815,-0.00874016,-0.05822791,0.03686721,0.02327131,0.00609782,-0.04049115,0.03231823,-0.16893798,0.02272918,0.06516081,0.0196601,0.05051684,-0.00624218,-0.02015006,-0.03666196,0.05208879,-0.06682595,0.00937693,0.03423056,0.04959733,0.06572515,0.00177316,0.05124512,-0.06832881,0.00128794,-0.04278376,0.03797391,-0.01309088,0.01564138,0.01525269,-0.01816235,0.04118613,-0.00314108,0.00886763,0.05551274,0.02690189,0.02332743,-0.00065565,0.00796597,-0.0536289,-0.20726842,0.03994797,0.00309741,-0.00498864,0.00647703,-0.01231378,0.03883446,0.02595559,-0.0578716,0.01608559,-0.02236417,0.04201972,-0.0059606,-0.02379017,0.01252793,-0.00430098,-0.03427819,-0.00737413,-0.00191128,0.04929256,-0.04746092,0.03198484,0.02384219,0.06771036,0.00872734,-0.10301453,0.02284112,-0.00038319,0.00069679,-0.05057525,0.02278847,0.09675147,-0.02017592,0.00560803,-0.02015997,0.03491714,-0.09609192,0.0942016,-0.01345482,-0.02812901,-0.058208,-0.03491213,0.01677434,0.01764005,-0.00177444,-0.05600518,-0.06433877,-0.01111733,-0.07394905,-0.01531777,0.00020956,-0.05347007,0.03441826,0.04745606,0.07092755,0.02425684,-0.00433017,-0.01516939,0.06516127,0.02578276,-0.02873705,-0.00387001,0.0313699,-0.02531559,0.05330918,0.05282633,0.03462465,-0.02407237,-0.00090503,-0.00329452,-0.06857289,-0.05711706,-0.01000915,-0.01200874,-0.05549626,0.02931569