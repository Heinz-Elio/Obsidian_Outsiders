2046912,-0.00296219,0.02510308,0.22203942,0.03398419,-0.00230919,-0.00412957,-0.00604596,0.02338929,0.05915416,-0.00080096,-0.05132367,-0.01291,0.05163981,-0.00548096,-0.01122217,-0.00456511,-0.03291821,0.06758071,-0.00387659,0.01563177,-0.06744429,0.03360034,-0.05912277,0.0165109,0.12429603,0.04012175,-0.01770163,-0.04999708,-0.01363609,0.01123885,-0.02723056,-0.03413192,-0.0213313,-0.00214919,-0.03173358,0.04993514,0.0332749,-0.0324664,-0.03427359,-0.0109441,-0.01122599,-0.01497471,0.05499392,0.03740369,0.07407723],"last_embed":{"tokens":14,"hash":"1nyef12"}}},"last_read":{"hash":"1nyef12","at":1778765616756},"class_name":"SmartSource","last_import":{"mtime":1778765611439,"size":38314,"at":1778765616409,"hash":"1nyef12"},"blocks":{"##03-06 12:00":[1,711],"##03-06 12:00#{1}":[3,592],"##03-06 12:00#夏洛克與華生偵探事務所":[593,594],"##03-06 12:00#助理調查員　日影凜空":[595,618],"##03-06 12:00#助理調查員　日影凜空#{1}":[597,618],"##03-06 12:00#敬愛的艾登．舒華澤少爺：":[619,626],"##03-06 12:00#敬愛的艾登．舒華澤少爺：#{1}":[621,626],"##03-06 12:00#敬愛的艾登．舒華澤少爺：#{2}":[627,628],"##03-06 12:00#請原諒我的唐突，這封信的內容原本應由我親自向你闡明，但事態緊急，我別無選擇。":[629,630],"##03-06 12:00#我理解你的困惑，「艾登．舒華澤」這個名字從未在你的人生中出現——但它確實屬於你。你的父母刻意抹去了自己的根源，試圖擺脫過去，導致你對此一無所知。他們不希望沉重的過去追上你，沒有人想，但過去就如同浪潮席捲而來，避無可避。":[631,632],"##03-06 12:00#你的父親出身於倫道爾的舒華澤家，是源自海底的古老族裔［彭達拉薩］一族的後人，擁有人類所沒有的特殊力量——法力。舒華澤家的祖先因為力量無法與其他族人共鳴而遭到驅逐，但也因此僥倖逃過異族的屠殺。雖然這些民族情仇於我們而言只是歷史，但同樣也有人受困於早已逝去的往日幻影，執著於重現昔日的輝煌。":[633,634],"##03-06 12:00#鬥爭的火種已被點燃。很快，過去的浪潮將追上你，我相信你知道應該如何應對。":[635,636],"##03-06 12:00#一位故人":[637,711],"##03-06 12:00#一位故人#{1}":[639,711]},"outlinks":[],"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:草稿/03-06.md##03-06 12:00": {"path":null,"last_embed":{"hash":"1nyef12","at":1778765616427},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.10929015,-0.01070484,0.05256634,-0.03244668,0.02769733,-0.02120093,0.04595397,-0.00568661,0.0391473,0.00559985,0.03570038,-0.08448189,0.0230866,0.00548648,0.03807267,0.04033109,0.00887502,-0.07180261,-0.01851031,-0.02925985,0.10718574,-0.0395028