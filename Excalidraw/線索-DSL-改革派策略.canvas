{
 "nodes": [
  {
   "id": "d75ae21741a94d91",
   "type": "group",
   "label": "公主脫離控制",
   "x": 672,
   "y": 901,
   "width": 640,
   "height": 1047
  },
  {
   "id": "891803f5f7adc05c",
   "type": "group",
   "label": "對克洛德的懷疑",
   "x": 1336,
   "y": 889,
   "width": 640,
   "height": 1368
  },
  {
   "id": "15b656be28fbb5d6",
   "type": "group",
   "label": "接觸人類與彭達拉薩人",
   "x": 2000,
   "y": 889,
   "width": 382,
   "height": 1641
  },
  {
   "id": "9590a700eb3a40e9",
   "type": "group",
   "label": "海底危機與陸地集結",
   "x": 2406,
   "y": 901,
   "width": 972,
   "height": 1344
  },
  {
   "id": "b503d9bb1f55ecce",
   "type": "group",
   "label": "目標與觸發",
   "x": 1502,
   "y": 46,
   "width": 640,
   "height": 726
  },
  {
   "id": "83a056d93f512c5f",
   "type": "group",
   "label": "阿德萊德支線",
   "x": 8,
   "y": 604,
   "width": 640,
   "height": 1059
  },
  {
   "id": "ffc792f432bf4380",
   "type": "text",
   "text": "**脫離控制**\n\n認為人魚公主脫離控制",
   "x": 1028,
   "y": 933,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "5b6580cf82607b68",
   "type": "text",
   "text": "**違抗**\n\n人魚公主違抗命令",
   "x": 696,
   "y": 1230,
   "width": 260,
   "height": 100,
   "color": "#2563EB"
  },
  {
   "id": "77ffb598d785d81a",
   "type": "text",
   "text": "**懷疑長老**\n\n人魚公主對長老有所懷疑",
   "x": 696,
   "y": 1527,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "8ec9182e8cd9ba9e",
   "type": "text",
   "text": "**暗示真相**\n\n暗示人魚公主的真相",
   "x": 696,
   "y": 1824,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "e4c510474b9492d8",
   "type": "text",
   "text": "**未報告**\n\n可伶未有按時報告",
   "x": 1028,
   "y": 1230,
   "width": 260,
   "height": 100,
   "color": "#2563EB"
  },
  {
   "id": "689a30e345be6206",
   "type": "text",
   "text": "**截報告**\n\n烏蘇拉截下報告",
   "x": 1028,
   "y": 1527,
   "width": 260,
   "height": 100,
   "color": "#EA580C"
  },
  {
   "id": "d421e099c9c0d546",
   "type": "text",
   "text": "**懷疑克洛德**\n\n對克洛德懷疑加劇，想收回控制權",
   "x": 1526,
   "y": 921,
   "width": 260,
   "height": 124,
   "color": "#7C3AED"
  },
  {
   "id": "dafe5e0874b5f5d8",
   "type": "text",
   "text": "**疑海都**\n\n懷疑與海都事件有關",
   "x": 1526,
   "y": 1230,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "a36131bd420716af",
   "type": "text",
   "text": "**水妖知行蹤**\n\n水妖掌握人魚公主行蹤",
   "x": 1360,
   "y": 1527,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "0c0956784dbc968b",
   "type": "text",
   "text": "**星羅誕生**\n\n星羅誕生時水妖與彭達拉薩人出現",
   "x": 1526,
   "y": 2109,
   "width": 260,
   "height": 124,
   "color": "#EA580C"
  },
  {
   "id": "e5921a5b1d1d653b",
   "type": "text",
   "text": "**沙羅解封**\n\n沙羅找到並解封埃爾確",
   "x": 1692,
   "y": 1527,
   "width": 260,
   "height": 100,
   "color": "#64748B"
  },
  {
   "id": "f7f2c82dc194c84d",
   "type": "text",
   "text": "**過於親近**\n\n人魚公主與人類、彭達拉薩人過於親近",
   "x": 2024,
   "y": 921,
   "width": 260,
   "height": 124,
   "color": "#2563EB"
  },
  {
   "id": "483d82411412d24f",
   "type": "text",
   "text": "**達姬放任**\n\n達姬放任人魚公主與他們接觸",
   "x": 2024,
   "y": 1230,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "33bb915ec34aeee2",
   "type": "text",
   "text": "**一同行動**\n\n與諾愛爾、可伶一同行動",
   "x": 2024,
   "y": 1527,
   "width": 260,
   "height": 100,
   "color": "#EA580C"
  },
  {
   "id": "943f6184fb9df18d",
   "type": "text",
   "text": "**介入者**\n\n彭達拉薩族介入者",
   "x": 2098,
   "y": 2406,
   "width": 260,
   "height": 100,
   "color": "#16A34A"
  },
  {
   "id": "09ac1a0cd2f1da34",
   "type": "text",
   "text": "**留陸地**\n\n長時間留在陸地",
   "x": 2596,
   "y": 933,
   "width": 260,
   "height": 100,
   "color": "#2563EB"
  },
  {
   "id": "fc68c7bfbb960c36",
   "type": "text",
   "text": "**海底不安全**\n\n海底不安全，需要留在陸地",
   "x": 2596,
   "y": 1230,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "e870cc403ff7d1d8",
   "type": "text",
   "text": "**只有埃爾確**\n\n只有埃爾確有能力與動機製造這樣的危機",
   "x": 2430,
   "y": 1515,
   "width": 260,
   "height": 124,
   "color": "#DC2626"
  },
  {
   "id": "05778d32ed7baeee",
   "type": "text",
   "text": "**海都襲擊**\n\n埃爾確解封，海都襲擊人魚王國",
   "x": 2430,
   "y": 1824,
   "width": 260,
   "height": 100,
   "color": "#EA580C"
  },
  {
   "id": "defb10ad7c0cfff7",
   "type": "text",
   "text": "**米迦勒襲擊**\n\n米迦勒襲擊人魚公主",
   "x": 2762,
   "y": 1527,
   "width": 260,
   "height": 100,
   "color": "#EA580C"
  },
  {
   "id": "c114a4b0858cff78",
   "type": "text",
   "text": "**仰賴北太平洋**\n\n營造必須仰賴北太平洋王國的局面",
   "x": 3011,
   "y": 1218,
   "width": 260,
   "height": 124,
   "color": "#7C3AED"
  },
  {
   "id": "f2fac71113714670",
   "type": "text",
   "text": "**陸地集結**\n\n迫使人魚公主在陸地集結，貿然分開回到王國反而危險",
   "x": 3094,
   "y": 1515,
   "width": 260,
   "height": 124,
   "color": "#7C3AED"
  },
  {
   "id": "a48b49bac2d440f5",
   "type": "text",
   "text": "**VPTS綁架**\n\nVPTS企圖綁架",
   "x": 2762,
   "y": 1824,
   "width": 260,
   "height": 100,
   "color": "#EA580C"
  },
  {
   "id": "eaff456bc8ab00ac",
   "type": "text",
   "text": "**阻止VPTS**\n\n需要有人阻止VPTS成功",
   "x": 2596,
   "y": 2121,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "3267b3486bce5899",
   "type": "text",
   "text": "**魅影帶到陸地**\n\n魅影小隊將逃亡的人魚公主帶到陸地",
   "x": 3094,
   "y": 1812,
   "width": 260,
   "height": 124,
   "color": "#64748B"
  },
  {
   "id": "a7a342aac612be85",
   "type": "text",
   "text": "**崩壞**\n\n星降神臨崩壞",
   "x": 1692,
   "y": 78,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "2a96f8219a050efe",
   "type": "text",
   "text": "**星盡**\n\n諾愛爾、可伶被處以星盡\n\n`推論`",
   "x": 1526,
   "y": 351,
   "width": 260,
   "height": 100,
   "color": "#EA580C"
  },
  {
   "id": "070bb9002e4e2ac6",
   "type": "text",
   "text": "**削弱**\n\n削弱星降神臨力量",
   "x": 1858,
   "y": 351,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "b48b7225caac7b34",
   "type": "text",
   "text": "**水妖襲擊**\n\n水妖不斷襲擊人魚公主，使干擾反覆解除\n\n`推論`",
   "x": 1858,
   "y": 624,
   "width": 260,
   "height": 124,
   "color": "#EA580C"
  },
  {
   "id": "19b6ec96060594ad",
   "type": "text",
   "text": "**不滿峰值**\n\n康士坦絲的不滿與懷疑達至峰值",
   "x": 1526,
   "y": 636,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "610f17dca9759752",
   "type": "text",
   "text": "**五長老**\n\n星盡需要五位大長老",
   "x": 364,
   "y": 636,
   "width": 260,
   "height": 100,
   "color": "#2563EB"
  },
  {
   "id": "d3f729d38ebb12ae",
   "type": "text",
   "text": "**迫下台**\n\n迫阿德萊德下台",
   "x": 364,
   "y": 933,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "ca3163593e704901",
   "type": "text",
   "text": "**對阿不滿**\n\n康士坦絲對阿德萊德產生不滿",
   "x": 32,
   "y": 1230,
   "width": 260,
   "height": 100,
   "color": "#7C3AED"
  },
  {
   "id": "5d9c3e05e9152c11",
   "type": "text",
   "text": "**送陸地**\n\n塞雷亞策劃送兩人到陸地，阿德萊德以管不住諾愛爾解釋",
   "x": 32,
   "y": 1515,
   "width": 260,
   "height": 124,
   "color": "#EA580C"
  },
  {
   "id": "bdaefcd9e289b02a",
   "type": "text",
   "text": "**叛變證據**\n\n阿德萊德叛變證據",
   "x": 364,
   "y": 1230,
   "width": 260,
   "height": 100,
   "color": "#2563EB"
  }
 ],
