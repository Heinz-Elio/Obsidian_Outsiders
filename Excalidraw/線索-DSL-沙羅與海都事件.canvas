{
	"nodes":[
		{"id":"891803f5f7adc05c","type":"group","label":"印度洋王國廢墟","x":1612,"y":8,"width":2324,"height":597},
		{"id":"15b656be28fbb5d6","type":"group","label":"防禦法術","x":1636,"y":60,"width":308,"height":522},
		{"id":"5da15b89b2fc91b0","type":"text","text":"沙羅記起自已被迪莉亞處以星盡","x":0,"y":314,"width":260,"height":52},
		{"id":"f43a41561b1ef5ae","type":"text","text":"信使暗示沙羅已死過一次","x":0,"y":123,"width":260,"height":52},
		{"id":"811296145ea0bde2","type":"text","text":"塞雷亞、達姬懷疑沙羅是冒牌貨","x":332,"y":314,"width":260,"height":52},
		{"id":"4dc2f56e4ce395fe","type":"text","text":"現任人魚公主死亡後新任公主才能誕生","x":166,"y":493,"width":260,"height":76},
		{"id":"fd208d3be9e015e0","type":"text","text":"沙羅找到並解封埃爾確","x":996,"y":314,"width":260,"height":52},
		{"id":"1cfea0f9f3ddfa32","type":"text","text":"法力失控導致的爆炸使長老團陷入混亂，未能追回沙羅","x":664,"y":111,"width":260,"height":76},
		{"id":"4ce99fda29d03349","type":"text","text":"北太平洋王國在海都事件沒有大得益","x":1328,"y":684,"width":260,"height":76},
		{"id":"2f1299ffb4a4807e","type":"text","text":"無法確定海都襲擊北太平洋王國是否克洛德自編自導","x":1328,"y":111,"width":260,"height":76},
		{"id":"9939ccb78e956212","type":"text","text":"證明自衛力量的重要性，衛隊得以明正言順存在","x":1328,"y":302,"width":260,"height":76},
		{"id":"03a25087283f3469","type":"text","text":"印度洋是保守派的勢力範圍，且未發現被克洛德滲透的跡象","x":996,"y":111,"width":260,"height":76},
		{"id":"d86c64b98be1de3b","type":"text","text":"內戰對北太平洋沒有好處","x":1328,"y":505,"width":260,"height":52},
		{"id":"50d362dfe898286f","type":"text","text":"動機不明確","x":1328,"y":875,"width":260,"height":52},
		{"id":"53d7fad2a43a7fb9","type":"text","text":"SWI不確定露芝亞如何前往印度洋、不知道是「沙羅」讓她去","x":664,"y":302,"width":260,"height":76},
		{"id":"03dcfcd38beefe6f","type":"text","text":"SWI與「沙羅」並非同伴","x":581,"y":505,"width":260,"height":52},
		{"id":"0d681143146529a3","type":"text","text":"「沙羅」是長老的傀儡","x":581,"y":696,"width":260,"height":52},
		{"id":"6030e4d84a6ee3d9","type":"text","text":"印度洋公主誕生","x":2324,"y":123,"width":260,"height":52},
		{"id":"11e945a221aadd85","type":"text","text":"廢墟下與米迦勒身上術式相同的修正力","x":1992,"y":111,"width":260,"height":76},
		{"id":"b14d9e5b686ece9d","type":"text","text":"米迦勒與施術者有關，V與兩者關係不明","x":1992,"y":302,"width":260,"height":76},
		{"id":"defb10ad7c0cfff7","type":"text","text":"米迦勒襲擊","x":2656,"y":123,"width":260,"height":52},
		{"id":"4486e60d8c9835a3","type":"text","text":"為游騎士（彭達拉薩人）介入提供契機","x":2656,"y":302,"width":260,"height":76},
		{"id":"81c9b426b859219d","type":"text","text":"米迦勒與V都知道印度洋公主將於何時誕生","x":2324,"y":302,"width":260,"height":76},
		{"id":"9690876eebeb54bc","type":"text","text":"露芝亞高調出現","x":2988,"y":123,"width":260,"height":52},
		{"id":"5d37243ffe0f3089","type":"text","text":"遇知目標抵達","x":2988,"y":314,"width":260,"height":52},
		{"id":"ffe1deeae7749b2e","type":"text","text":"海洋生物無法靠近","x":3320,"y":123,"width":260,"height":52},
		{"id":"055e0438bb8dfc1d","type":"text","text":"空間的篩選邏輯","x":3652,"y":123,"width":260,"height":52},
		{"id":"c1036bb1175e370c","type":"text","text":"只剩下保護誓約之泉的部分仍在運作","x":1660,"y":111,"width":260,"height":76},
		{"id":"91f0bae38a311745","type":"text","text":"能量供給充足","x":1660,"y":314,"width":260,"height":52},
		{"id":"6cbaba9ff238f3d9","type":"text","text":"集成了環境能量收集","x":1660,"y":505,"width":260,"height":52}
	],
