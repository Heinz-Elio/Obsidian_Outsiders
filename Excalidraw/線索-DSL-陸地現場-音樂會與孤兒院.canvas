		{"id":"54446d7342cadeac","type":"group","label":"尼歌娜","x":4324,"y":111,"width":308,"height":378},
		{"id":"d9162b012ce923e5","type":"text","text":"塞雷亞清楚人魚公主行蹤","x":0,"y":1321,"width":260,"height":52},
		{"id":"a6d7d30b4dacdb13","type":"text","text":"達姬與尼歌娜都大致理解其他王國的狀況","x":5344,"y":162,"width":260,"height":76},
		{"id":"3b33fa789567e336","type":"text","text":"尼歌姬會管束公主，達姬則鼓勵公主享受","x":5676,"y":162,"width":260,"height":76},
		{"id":"ca012813b96a2902","type":"text","text":"尼歌娜和達姬的角色與各自的身份閱歷不符，達姬理應比尼歌娜更清楚犯錯的後果以及帶來的外交問題","x":5676,"y":366,"width":260,"height":124},
		{"id":"e7c03b39935b4dd9","type":"text","text":"其他王國十分重視規矩，犯規會被嚴懲","x":6008,"y":162,"width":260,"height":76},
		{"id":"28a6dd4fbf95cd1a","type":"text","text":"水妖對人魚公主的行蹤有一定掌握，且從來不會在人魚公主忙碌時出現","x":6340,"y":150,"width":260,"height":100},
		{"id":"344392e3466c06f1","type":"text","text":"有人密切監視人魚公主動向","x":6340,"y":402,"width":260,"height":52},
		{"id":"ac24682bfdd0a2b9","type":"text","text":"多人監視人魚公主","x":996,"y":174,"width":260,"height":52},
		{"id":"00350ca7861456cc","type":"text","text":"保守派監視者","x":996,"y":402,"width":260,"height":52},
		{"id":"74f8cf022f82482d","type":"text","text":"改革派與保守派矛盾","x":996,"y":604,"width":260,"height":52},
		{"id":"d7dd140f1e16ff10","type":"text","text":"彭達拉薩人的存在十分敏感，會激化人魚內部矛盾","x":996,"y":772,"width":260,"height":76},
		{"id":"4ffe86ff21227538","type":"text","text":"就算不至內戰也會瓦解同盟","x":664,"y":975,"width":260,"height":52},
		{"id":"24ff1b273d28447b","type":"text","text":"塞雷亞明知而同意合作，且刻意淡化問題","x":996,"y":963,"width":260,"height":76},
		{"id":"3dffff398c39b824","type":"text","text":"塞雷亞向VPTS洩密","x":498,"y":1488,"width":260,"height":52},
		{"id":"61ca95860e34ef71","type":"text","text":"與北太平洋立場矛盾","x":996,"y":1154,"width":260,"height":52},
		{"id":"f0f3db644ebfa861","type":"text","text":"塞雷亞與長老目標不同","x":664,"y":1321,"width":260,"height":52},
		{"id":"26a4bb2e830d24f6","type":"text","text":"北太平洋有意挑起爭端","x":996,"y":1321,"width":260,"height":52},
		{"id":"1c187786bbb46b68","type":"text","text":"不利米迦勒復興海之住民","x":332,"y":1154,"width":260,"height":52},
		{"id":"4dfec7118bf3606a","type":"text","text":"復興不是米迦勒的真正目的","x":332,"y":1321,"width":260,"height":52},
		{"id":"2d247acea143c5ef","type":"text","text":"長老向VPTS洩密","x":996,"y":1488,"width":260,"height":52},
		{"id":"cbde140d3079a65c","type":"text","text":"有利米迦勒綁架人魚公主","x":664,"y":1154,"width":260,"height":52},
		{"id":"0413deaf6fbf9f68","type":"text","text":"挑起內部爭端","x":498,"y":1655,"width":260,"height":52},
		{"id":"b54744f9611fec6b","type":"text","text":"選擇孤兒院的理由：暗指人魚公主沒有父母，形同孤兒","x":4680,"y":162,"width":260,"height":76},
		{"id":"a5ab6a6d0338dfae","type":"text","text":"29年前發生火災，案件紀錄3人倖存","x":5012,"y":162,"width":260,"height":76},
		{"id":"e650b9db679a14d1","type":"text","text":"場景含意","x":1336,"y":174,"width":260,"height":52},
		{"id":"bcece6719db8a3e0","type":"text","text":"地下室有APCS，導致未能提前發現沙羅","x":4016,"y":162,"width":260,"height":76},
		{"id":"3ac26482a529bb25","type":"text","text":"手套","x":4016,"y":402,"width":260,"height":52},
