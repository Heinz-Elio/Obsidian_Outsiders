		{"id":"9590a700eb3a40e9","type":"group","label":"第三次綁架行動","x":2924,"y":111,"width":308,"height":330},
		{"id":"b503d9bb1f55ecce","type":"group","label":"第二張門票","x":3588,"y":111,"width":308,"height":343},
		{"id":"83a056d93f512c5f","type":"group","label":"護照","x":3904,"y":8,"width":1684,"height":876},
		{"id":"6eca50fefd90742f","type":"group","label":"第三方人員","x":3928,"y":60,"width":996,"height":800},
		{"id":"a19268416bb74cc2","type":"group","label":"未爆彈","x":3952,"y":111,"width":308,"height":725},
		{"id":"cad237245f8656f7","type":"text","text":"必須經印度才能在時限內打開保險櫃","x":0,"y":151,"width":260,"height":76},
		{"id":"700fc2acfe34d9e8","type":"text","text":"清道夫開始核查諾愛爾背景","x":2284,"y":163,"width":260,"height":52},
		{"id":"173862b6c0790d79","type":"text","text":"清道夫試圖誤導終端機文件尚未交出","x":2616,"y":151,"width":260,"height":76},
		{"id":"cb8f5bac85a2d6cf","type":"text","text":"發現之前收到的是假報告後馬上洗機並更換聯繫方式，無法繼續追查","x":308,"y":736,"width":260,"height":100},
		{"id":"06ea8665b0f7151c","type":"text","text":"積極調查SWI","x":3280,"y":366,"width":260,"height":52},
		{"id":"dd8159da2edc0131","type":"text","text":"董事長黑克勒認識的一名前軍方高層投資了遠古生物及文明研究所","x":640,"y":736,"width":260,"height":100},
		{"id":"aa8f73b993d1a006","type":"text","text":"派遣O-117前往和歌山","x":3280,"y":557,"width":260,"height":52},
		{"id":"31831dd00e322fc5","type":"text","text":"VPTS掌握所有人魚公主的行蹤，並據此策劃連串行動","x":644,"y":151,"width":260,"height":76},
		{"id":"f617631cc2d4bcd3","type":"text","text":"V是真正的委託人","x":972,"y":557,"width":260,"height":52},
		{"id":"3e5de404bb6da3be","type":"text","text":"委託人由中介組織僱用，情報由其他人提供","x":640,"y":354,"width":260,"height":76},
		{"id":"6684b6022887c200","type":"text","text":"以電郵聯繫，但其電腦只用作與單一對象聯繫，位址在法國","x":308,"y":545,"width":260,"height":76},
		{"id":"0278b5ded7b33a42","type":"text","text":"只有V知道人魚公主必然會經印度回國","x":972,"y":354,"width":260,"height":76},
		{"id":"7f84b671bf64bfd6","type":"text","text":"實際上是秘密交易，委託只是形式","x":640,"y":545,"width":260,"height":76},
		{"id":"fcc104a650351310","type":"text","text":"有財力聘用更好的傭兵達成目標","x":1288,"y":163,"width":260,"height":52},
		{"id":"cd8d5f11fad7c24b","type":"text","text":"行事謹慎，熟知地下商業的運作","x":1873,"y":366,"width":260,"height":52},
		{"id":"5629e025676749ac","type":"text","text":"能夠判斷TI能力不足以完成委託","x":1470,"y":545,"width":260,"height":76},
		{"id":"01f197b1ad07fdc8","type":"text","text":"經中介找人與TI接洽","x":1952,"y":163,"width":260,"height":52},
		{"id":"83aa0d80f36cd77b","type":"text","text":"VPTS失敗的保險","x":1379,"y":760,"width":260,"height":52},
		{"id":"d439df2c3da65893","type":"text","text":"TI失敗後仍繼續委託，直到TI全滅","x":1620,"y":151,"width":260,"height":76},
		{"id":"812c98a6e557c9e7","type":"text","text":"非情報來源，情報提供方式與VPTS的委託人相同","x":1711,"y":748,"width":260,"height":76},
		{"id":"863c25db391b7a26","type":"text","text":"專業情報人員","x":1499,"y":951,"width":260,"height":52},
		{"id":"46f413fe317db797","type":"text","text":"委託人想借TI消耗VPTS的力量","x":1383,"y":354,"width":260,"height":76},
		{"id":"413dccc1213026b6","type":"text","text":"VPTS發現屍體失蹤","x":2948,"y":163,"width":260,"height":52},
		{"id":"d7201a6a018cad6d","type":"text","text":"事後調查被列為機密","x":2948,"y":366,"width":260,"height":52},
		{"id":"f90b513e26d702be","type":"text","text":"準點傳送至保險箱","x":3612,"y":163,"width":260,"height":52},
		{"id":"c467cb1e3241b440","type":"text","text":"V事前曾親自或派人到印度確認座標","x":3612,"y":354,"width":260,"height":76},
		{"id":"e740ebc7d7311a0c","type":"text","text":"諾愛爾與可伶為法國籍，可可卻是日本籍","x":4972,"y":151,"width":260,"height":76},
		{"id":"7d9dd6e7c9087e62","type":"text","text":"根據簽發日期與入境紀錄，諾愛爾在拿到護照後便馬上前往加拿大","x":5304,"y":139,"width":260,"height":100},
		{"id":"a58e79ae64d3e8eb","type":"text","text":"兩人本來就擁有法國國籍","x":4960,"y":366,"width":260,"height":52},
		{"id":"e94b93680d3ed1f4","type":"text","text":"兩人需辦理工作簽證","x":5292,"y":366,"width":260,"height":52},
		{"id":"4bc04a25cb07f60d","type":"text","text":"全套防護裝備、隱匿術式","x":4308,"y":163,"width":260,"height":52},
		{"id":"30326601b9f9ec8d","type":"text","text":"預期會與其他人交鋒","x":4308,"y":366,"width":260,"height":52},
		{"id":"90c458bc87bea597","type":"text","text":"隸屬TI，公司核心成員是游離者","x":4640,"y":151,"width":260,"height":76},
		{"id":"e9ed591a8e76df73","type":"text","text":"明明可以在對手行動前直接在遠處狙殺，卻選擇正面交鋒","x":4308,"y":545,"width":260,"height":76},
		{"id":"1584de20c1502691","type":"text","text":"故意使用未爆彈測試SWI","x":3976,"y":163,"width":260,"height":52},
		{"id":"77f52be0097a2bcd","type":"text","text":"不知道是未爆彈，意圖殺害人魚公主","x":3976,"y":545,"width":260,"height":76},
		{"id":"f310345b8a206fce","type":"text","text":"策劃者欠缺判斷能力","x":3976,"y":760,"width":260,"height":52},
