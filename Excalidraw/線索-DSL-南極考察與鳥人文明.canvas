{
	"nodes":[
		{"id":"891803f5f7adc05c","type":"group","label":"南極考察點","x":616,"y":32,"width":2706,"height":2134},
		{"id":"15b656be28fbb5d6","type":"group","label":"孫天烺","x":3330,"y":32,"width":308,"height":127},
		{"id":"9590a700eb3a40e9","type":"group","label":"海之住民化石再現","x":3662,"y":8,"width":1636,"height":784},
		{"id":"c2b12e33e5e0ffab","type":"text","text":"研究將生物改造成MS","x":166,"y":286,"width":260,"height":52},
		{"id":"a94d7dea61f47555","type":"text","text":"星降神臨的核心功能是改造生物","x":0,"y":84,"width":260,"height":52},
		{"id":"5634dd283cdce7d9","type":"text","text":"MS資料","x":332,"y":84,"width":260,"height":52},
		{"id":"7bf7394a80750656","type":"text","text":"航海日誌","x":1387,"y":286,"width":260,"height":52},
		{"id":"b629c28b6ab81412","type":"text","text":"地圖","x":1719,"y":286,"width":260,"height":52},
		{"id":"252502912cee5e10","type":"text","text":"南極一山洞深處的神殿遺跡","x":1802,"y":501,"width":260,"height":52},
		{"id":"a1c3d3bf984d1484","type":"text","text":"恐懼使人瘋狂","x":972,"y":717,"width":260,"height":52},
		{"id":"63cfe89b74f44089","type":"text","text":"未知語言","x":972,"y":501,"width":260,"height":52},
		{"id":"51c67c390e1533e0","type":"text","text":"製造出信使實行計劃","x":972,"y":908,"width":260,"height":52},
		{"id":"c90e590554afee5b","type":"text","text":"器具、建築設計不適合人型生物使用","x":1968,"y":705,"width":260,"height":76},
		{"id":"8f4cf982b280fb82","type":"text","text":"種族因不明原因步向衰落，族人研究復興種族之法","x":640,"y":896,"width":260,"height":76},
		{"id":"b1c761515b527657","type":"text","text":"張睿稱神殿大門處於關閉狀態","x":2300,"y":717,"width":260,"height":52},
		{"id":"fd21f8a4994665cf","type":"text","text":"天城博敏中止考察，回到美國完成論文後與化石先後下落不明","x":1553,"y":1278,"width":260,"height":76},
		{"id":"340d24d346e2125b","type":"text","text":"傳家寶","x":1553,"y":84,"width":260,"height":52},
		{"id":"aa4557a1c3e90b26","type":"text","text":"警告石碑","x":1636,"y":717,"width":260,"height":52},
		{"id":"80f5ea82c3c689f0","type":"text","text":"星降神臨長期收集基質","x":640,"y":717,"width":260,"height":52},
		{"id":"f4616284776dac74","type":"text","text":"以奴隸之DNA進行製造容器實驗","x":640,"y":1278,"width":260,"height":76},
		{"id":"f41b79cf55fd06dd","type":"text","text":"捨棄肉體保留靈魂，將來轉移至新容器","x":640,"y":1087,"width":260,"height":76},
		{"id":"109abb1fc82ce8f2","type":"text","text":"信使是鳥人原生樣貌","x":1774,"y":1099,"width":260,"height":52},
		{"id":"df66b407555dbeb8","type":"text","text":"米迦勒：將奴隸DNA植入美嘉留產生","x":1635,"y":2066,"width":260,"height":76},
		{"id":"cb4ca9e88ca40c60","type":"text","text":"壁畫","x":2632,"y":717,"width":260,"height":52},
		{"id":"fee406f3838bb244","type":"text","text":"完整化石不足半米高","x":1636,"y":908,"width":260,"height":52},
		{"id":"69b3e3bfeeaa2e26","type":"text","text":"信使是王的複製品","x":2106,"y":1290,"width":260,"height":52},
		{"id":"1d6f975340518fc7","type":"text","text":"人頭鳥身，其中一隻有光環","x":2042,"y":908,"width":260,"height":52},
		{"id":"4d07e8d2bb77c097","type":"text","text":"光環是特殊象徵","x":2106,"y":1099,"width":260,"height":52},
		{"id":"bb9c2f1f28ef8732","type":"text","text":"美嘉留擁有彭達拉薩血統","x":2578,"y":84,"width":260,"height":52},
		{"id":"a675a2aa4c7315d7","type":"text","text":"現代人類會對DNA產生排斥","x":640,"y":1505,"width":260,"height":52},
		{"id":"4914a7c6d9a85f45","type":"text","text":"帶有古代人類血統的人不會排斥DNA，但僅能重現人格，且人格無法控制宿主，反而會受美嘉留影響","x":972,"y":1469,"width":260,"height":124},
		{"id":"c7c02272702a0976","type":"text","text":"出現意外，裝置變成怪物","x":1138,"y":1290,"width":260,"height":52},
		{"id":"8d81dcc47e7ff134","type":"text","text":"正本失蹤，副本只有抵達前的部分，抵達後（以未知語言寫成）的部分被撕走","x":1304,"y":477,"width":260,"height":100},
		{"id":"8e39317ecdc980a3","type":"text","text":"看懂的人想要隱瞞","x":1304,"y":717,"width":260,"height":52},
		{"id":"c64ab21ca8b98132","type":"text","text":"美嘉留與米迦勒氣息相似","x":1737,"y":1899,"width":260,"height":52},
		{"id":"b5ba78147892a1a4","type":"text","text":"米迦勒出現時美嘉留衰弱","x":1152,"y":1899,"width":260,"height":52},
		{"id":"cac63b2de22aa431","type":"text","text":"大門打開，信使與怪物被喚醒，澤井陽基控制信使、天城博敏","x":972,"y":1087,"width":260,"height":76},
		{"id":"b848699158de2040","type":"text","text":"突然出現帶走美嘉留，不久後美嘉留被送回家","x":1636,"y":1708,"width":260,"height":76},
		{"id":"593b1e300206ae2e","type":"text","text":"不信邪的船員打開大門，船員與怪物戰鬥，暫時停止其行動後脫逃","x":1304,"y":1481,"width":260,"height":100},
		{"id":"91f230eaaf5d0da9","type":"text","text":"澤井陽基解封","x":1304,"y":1720,"width":260,"height":52},
		{"id":"90795fab6dc19105","type":"text","text":"依靠美嘉留的力量顯現","x":972,"y":1720,"width":260,"height":52},
		{"id":"7dc2720792249e10","type":"text","text":"考察隊離開後有人進入神殿","x":2706,"y":908,"width":260,"height":52},
		{"id":"ccd6ca51a3e852fe","type":"text","text":"大門以人類的力氣無法推開","x":2374,"y":908,"width":260,"height":52},
		{"id":"0985f8fd90121ce3","type":"text","text":"米迦勒空間裡的城堡","x":3038,"y":908,"width":260,"height":52},
		{"id":"f3b5471265fe9e03","type":"text","text":"米迦勒與鳥人一族有關","x":3038,"y":1099,"width":260,"height":52},
		{"id":"a3e62c60212bda03","type":"text","text":"澤井陽基","x":1304,"y":908,"width":260,"height":52},
		{"id":"27524bea823570a5","type":"text","text":"在南極考察後失蹤","x":1304,"y":1099,"width":260,"height":52},
		{"id":"b0f0b17ce83156d6","type":"text","text":"官方認定考察成果造假","x":1636,"y":1505,"width":260,"height":52},
		{"id":"ccce5f02753f8c93","type":"text","text":"海之住民不會自稱海之住民","x":2069,"y":1505,"width":260,"height":52},
		{"id":"bdb3831f6519e01a","type":"text","text":"米迦勒的自稱是現代人告訴他的","x":2069,"y":1720,"width":260,"height":52},
		{"id":"106450943805dc7f","type":"text","text":"有人喚醒/復活米迦勒","x":2069,"y":1899,"width":260,"height":52},
		{"id":"4559b45a95724e06","type":"text","text":"使用法術","x":2540,"y":1099,"width":260,"height":52},
		{"id":"dfdd68eb501a0562","type":"text","text":"投資南極考察","x":3354,"y":84,"width":260,"height":52},
		{"id":"2d78c6748e96597d","type":"text","text":"LB奉命搶奪化石","x":3686,"y":84,"width":260,"height":52},
		{"id":"5b574e848d1e0ff5","type":"text","text":"化石對米迦勒有用/不利","x":3686,"y":286,"width":260,"height":52},
		{"id":"6a70618f6de9a379","type":"text","text":"斯普魯恩斯在人魚公主擊敗水妖後回收化石","x":4018,"y":274,"width":260,"height":76},
		{"id":"d31f76fa8c084176","type":"text","text":"深海之星派斯普魯恩斯確認化石真實性，鑑定報告證明化石確屬海之住民，需回收以保密海之住民存在","x":3769,"y":465,"width":260,"height":124},
		{"id":"831b34bda176b42b","type":"text","text":"斯普魯恩斯追上水妖並短暫交手，因人魚公主出現而收手","x":4018,"y":72,"width":260,"height":76},
		{"id":"3f1010709d797684","type":"text","text":"刻意讓人魚公主解決","x":4350,"y":286,"width":260,"height":52},
		{"id":"d973953c1da4c8ed","type":"text","text":"塞雷亞有保密義務","x":3769,"y":717,"width":260,"height":52},
		{"id":"c7e6858a4f6000e2","type":"text","text":"美嘉收到信件，在海斗陪同下參觀展覽","x":4350,"y":72,"width":260,"height":76},
		{"id":"1bfebc8c635409cb","type":"text","text":"斯普魯恩斯無法提供詳細訊息予非成員，要求塞雷亞向深海之星提交查詢申請","x":4682,"y":60,"width":260,"height":100},
		{"id":"02c5fd8a88b8cfca","type":"text","text":"斯普魯恩斯對米迦勒事件態度冷漠","x":4682,"y":274,"width":260,"height":76},
		{"id":"d1be5c2a2922f724","type":"text","text":"深海之星知道人魚公主的真相","x":4599,"y":501,"width":260,"height":52},
		{"id":"7d83256130e9bbd3","type":"text","text":"化石已回收封存，應是內部人員賣至黑市","x":4101,"y":489,"width":260,"height":76},
		{"id":"99b0cdb21d90bf8c","type":"text","text":"化石來自南極，可能伴有遺跡，與米迦勒身份相關","x":5014,"y":72,"width":260,"height":76}
	],
