{
	"nodes":[
		{"id":"891803f5f7adc05c","type":"group","label":"事件","x":2316,"y":60,"width":972,"height":977},
		{"id":"15b656be28fbb5d6","type":"group","label":"假秘書是誰？","x":8,"y":311,"width":1636,"height":702},
		{"id":"9590a700eb3a40e9","type":"group","label":"兇手是誰？","x":4382,"y":8,"width":2608,"height":1150},
		{"id":"b503d9bb1f55ecce","type":"group","label":"接載張睿的司機","x":5022,"y":60,"width":640,"height":392},
		{"id":"83a056d93f512c5f","type":"group","label":"文件交給誰？","x":3312,"y":48,"width":1046,"height":1111},
		{"id":"6eca50fefd90742f","type":"group","label":"真相","x":7014,"y":48,"width":640,"height":224},
		{"id":"a19268416bb74cc2","type":"group","label":"誰在引導調查？","x":1668,"y":574,"width":640,"height":176},
		{"id":"a90fcd2caf91ce6d","type":"text","text":"**研究所背景**\n\n天城博敏曾帶天城美嘉留前往研究所治療，見 [[線索-DSL-研究所與考察造假]]","x":696,"y":99,"width":260,"height":148,"color":"#64748B"},
		{"id":"86cfd225caebe52a","type":"text","text":"**首次會面要求遭拒**\n\nIN聯絡研究團隊成員表示希望見面，第一次全部遭拒","x":3004,"y":111,"width":260,"height":124,"color":"#EA580C"},
		{"id":"6170bff06e0e2e48","type":"text","text":"**二次聯絡回覆可約見**\n\n秘書稱第一次拒絕是因為張睿正在公幹","x":3004,"y":362,"width":260,"height":124,"color":"#EA580C"},
		{"id":"dd37a059b4ebb639","type":"text","text":"會面時假秘書旁聽","x":2514,"y":649,"width":260,"height":52,"color":"#EA580C"},
		{"id":"8692f36e9bc92790","type":"text","text":"**遇害**\n\n會面後數天，張睿接到電話後匆忙離開辦公室，同日在小巷被槍殺，翌日被流浪漢發現並報案","x":3004,"y":864,"width":260,"height":148,"color":"#EA580C"},
		{"id":"077db597c3210d79","type":"text","text":"案發時三人已離境","x":2672,"y":398,"width":260,"height":52,"color":"#EA580C"},
		{"id":"5fed12d6323590b4","type":"text","text":"**真秘書證詞**\n\n真秘書向警察透露曾有人想約見張睿，詢問造假事件","x":2340,"y":362,"width":260,"height":124,"color":"#EA580C"},
		{"id":"4796962dd2569200","type":"text","text":"**警方懷疑Kafziel**\n\n警察懷疑可能受過相關訓練的Kafziel，但因其身份而謹慎處理","x":3004,"y":601,"width":260,"height":148,"color":"#EA580C"},
		{"id":"601ae0ee9f1a09f5","type":"text","text":"**秘書送美嘉留**\n\n秘書是當年送天城美嘉留回家的人","x":696,"y":362,"width":260,"height":124},
		{"id":"f177fdadec1e55db","type":"text","text":"**某人模仿真秘書**\n\n某人刻意模仿真秘書說話方式，令情報人員未有察覺接聽者不同\n\n`採信`","x":32,"y":613,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"437f2e9502f8b7bf","type":"text","text":"**赴法旅遊**\n\n實際上張睿請假與假秘書到法國旅遊","x":696,"y":613,"width":260,"height":124,"color":"#2563EB"},
		{"id":"ab15a133aff217e1","type":"text","text":"**行程說法不一**\n\n真秘書的說法是張睿當時放假與妻子外遊，妻子的說法是張睿外出公幹，兩人都沒有和張睿出國","x":364,"y":601,"width":260,"height":148,"color":"#2563EB"},
		{"id":"9bd6f420b2e5588b","type":"text","text":"**無人知道情婦**\n\n假秘書甚少露臉，張睿亦不曾場向他人提及，所以張睿身邊的人都不知其存在","x":1028,"y":601,"width":260,"height":148,"color":"#2563EB"},
		{"id":"3f34f41495205566","type":"text","text":"暗中調查","x":490,"y":912,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"d37538ed55b76d53","type":"text","text":"**出軌對象**\n\n秘書是張睿的出軌對象\n\n`排除`","x":948,"y":888,"width":260,"height":100,"color":"#CBD5E1"},
		{"id":"6c2f68aa30dd1299","type":"text","text":"**幽會不合理**\n\n選擇有人拜訪時幽會不合理","x":1360,"y":625,"width":260,"height":100,"color":"#DC2626"},
		{"id":"4064e16a5e656499","type":"text","text":"**監視誤導**\n\n監視張睿、誤導調查\n\n`採信`","x":1280,"y":888,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"9b44a79ee9544821","type":"text","text":"財物消失","x":4738,"y":398,"width":260,"height":52,"color":"#2563EB"},
		{"id":"dab594825dceb8d5","type":"text","text":"劫殺\n\n`排除`","x":4668,"y":649,"width":260,"height":52,"color":"#CBD5E1"},
		{"id":"82ac046e55550477","type":"text","text":"**約見某人後被殺**\n\n張睿與某人相約見面，之後遭殺害，兇手偽裝成隨機劫殺","x":4406,"y":362,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"6c6c3ed5b0f8b005","type":"text","text":"**無目擊者**\n\n現場附近人跡罕至，沒有目擊者","x":4714,"y":123,"width":260,"height":100,"color":"#2563EB"},
		{"id":"d159580d0900739e","type":"text","text":"**死亡時間**\n\n死亡時間在掛上電話後一段時間","x":5710,"y":123,"width":260,"height":100,"color":"#2563EB"},
		{"id":"3b25ce6cb56d98d0","type":"text","text":"**消失的領帶夾**\n\n張睿稱是妻子所送","x":6042,"y":123,"width":260,"height":100,"color":"#2563EB"},
		{"id":"adb83bc7c7d0b9d3","type":"text","text":"妻子不認得領帶夾","x":6374,"y":147,"width":260,"height":52,"color":"#2563EB"},
		{"id":"ff6f3146fdea2e34","type":"text","text":"假秘書所送","x":6208,"y":398,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"0700b292fc630944","type":"text","text":"兇手是約見方","x":5686,"y":398,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"a7225671ec4431de","type":"text","text":"**約見方滅口**\n\n約見方出現在小巷滅口","x":6706,"y":123,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"0d062f0fa3876322","type":"text","text":"**兇手非約見方**\n\n約見方並未出現在小巷","x":4406,"y":888,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"5f234c0a63a75b25","type":"text","text":"兇手是假秘書","x":6208,"y":649,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"fbadbd5fb62f760c","type":"text","text":"**下車後接電話**\n\n張睿下車後沒有馬上走進巷子，而是在路邊接電話","x":5046,"y":111,"width":260,"height":124,"color":"#2563EB"},
		{"id":"b7e70f1363ebb84b","type":"text","text":"**15分鐘後巨響**\n\n落客至少15分鐘後聽到巨響，但因怕麻煩未有回頭查看","x":5378,"y":111,"width":260,"height":124,"color":"#2563EB"},
		{"id":"082a38041e1d6a5a","type":"text","text":"空公文包","x":4074,"y":398,"width":260,"height":52,"color":"#2563EB"},
		{"id":"dc8efc2b0580fdd9","type":"text","text":"**文件已交出**\n\n文件實際已交出，張睿是在偽裝準備交收","x":4074,"y":613,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"82c2f490312e2627","type":"text","text":"**情報人員交接**\n\n張睿與約見方皆為情報人員，擔心被跟蹤","x":3742,"y":613,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"da9a2d573d32d1fa","type":"text","text":"**多次換乘前通話**\n\n張睿死前與單一號碼多次通話，通話結束後張睿下車換線或換交通工具","x":3769,"y":99,"width":260,"height":148,"color":"#2563EB"},
		{"id":"ebb16c2e5588e148","type":"text","text":"**私人電話**\n\n約見者有張睿私人電話，不會經秘書聯絡","x":3668,"y":362,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"6749e29f640e7c04","type":"text","text":"**反偵察訓練**\n\n約見方受過反偵察訓練","x":3336,"y":374,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"8ad99dc004de616a","type":"text","text":"**真相**\n\n見 [[張睿案-真相]]","x":7038,"y":123,"width":260,"height":100,"color":"#64748B"},
		{"id":"660b3be031931c41","type":"text","text":"**地鐵調包**\n\n事先安排與張睿身材接近的人接應，在擠迫的地鐵上貼著站，與張睿交換裝有文件的公事包","x":7370,"y":99,"width":260,"height":148},
		{"id":"a434f54bd2061064","type":"text","text":"誤導警方調查","x":1692,"y":649,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"ffcb932410c00efe","type":"text","text":"**引導調查**\n\n引導他們調查教授之死","x":2024,"y":625,"width":260,"height":100,"color":"#7C3AED"}
	],
	"edges":[
