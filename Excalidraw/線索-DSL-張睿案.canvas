  },
  {
   "id": "349a3935434576a6",
   "fromNode": "082a38041e1d6a5a",
   "fromSide": "bottom",
   "toNode": "dc8efc2b0580fdd9",
   "toSide": "top",
   "color": "#1F2937",
   "label": "支持"
