{
	"nodes":[
		{"id":"891803f5f7adc05c","type":"group","label":"張睿秘書","x":3568,"y":32,"width":972,"height":1513},
		{"id":"15b656be28fbb5d6","type":"group","label":"張睿被殺","x":948,"y":8,"width":2300,"height":1191},
		{"id":"9590a700eb3a40e9","type":"group","label":"接載張睿的司機","x":972,"y":247,"width":640,"height":152},
		{"id":"05dfeb076efce2cd","type":"text","text":"秘書是當年送天城美嘉留回家的人","x":0,"y":502,"width":260,"height":76},
		{"id":"ff9322faaff9cc2a","type":"text","text":"天城博敏、張睿曾在同一研究所工作","x":486,"y":84,"width":260,"height":76},
		{"id":"dd5258ce7d06d1ca","type":"text","text":"天城博敏曾帶天城美嘉留前往研究所治療","x":332,"y":298,"width":260,"height":76},
		{"id":"baf5a870308d9f39","type":"text","text":"天城博敏本答應完成收尾工作就回家，但再次失去聯絡","x":332,"y":502,"width":260,"height":76},
		{"id":"7c2aace74fe84888","type":"text","text":"研究可能與海之住民、化石有關","x":664,"y":514,"width":260,"height":52},
		{"id":"14a9aa5a351d3f36","type":"text","text":"澤井陽基是天城博敏的引薦人","x":664,"y":310,"width":260,"height":52},
		{"id":"b22998cc35524618","type":"text","text":"真秘書向警察透露曾有人想約見張睿，詢問考察造假事件","x":3272,"y":298,"width":260,"height":76},
		{"id":"486010db0bce1f96","type":"text","text":"事先安排與張睿身材接近的人接應，在擠迫的地鐵上貼著站，與張睿交換裝有文件的公事包","x":4564,"y":72,"width":260,"height":100},
		{"id":"1b00a811a99e8439","type":"text","text":"IN聯絡研究團隊成員表示希望見面，第一次全部遭拒","x":3604,"y":84,"width":260,"height":76},
		{"id":"ddee397e57c31e36","type":"text","text":"第二次聯絡時張睿的秘書回覆可以約見","x":3604,"y":298,"width":260,"height":76},
		{"id":"a192d96ec90ef165","type":"text","text":"刻意模仿真秘書說話方式，令情報人員未有察覺接聽者不同","x":3592,"y":502,"width":260,"height":76},
		{"id":"dd37a059b4ebb639","type":"text","text":"會面時假秘書旁聽","x":4256,"y":1302,"width":260,"height":52},
		{"id":"5e01017020bef3dc","type":"text","text":"第一次不答應是因為張睿正在外公幹","x":3924,"y":502,"width":260,"height":76},
		{"id":"293cf3a9f0a4e02b","type":"text","text":"實際上張睿請假與假秘書到法國旅遊","x":3924,"y":705,"width":260,"height":76},
		{"id":"3f34f41495205566","type":"text","text":"暗中調查","x":3592,"y":908,"width":260,"height":52},
		{"id":"958605ea031589a1","type":"text","text":"秘書是張睿的出軌對象","x":3924,"y":908,"width":260,"height":52},
		{"id":"fb817876c8dabdfb","type":"text","text":"選擇有人拜訪時幽會不合理","x":3924,"y":1302,"width":260,"height":52},
		{"id":"f87ca069c11273ce","type":"text","text":"假秘書甚少露臉，張睿亦不曾場向他人提及，所以張睿身邊的人都不知其存在","x":3924,"y":1087,"width":260,"height":100},
		{"id":"57b79bbe395f4717","type":"text","text":"真秘書的說法是張睿當時放假與妻子外遊，妻子的說法是張睿外出公幹，兩人都沒有和張睿出國","x":4256,"y":490,"width":260,"height":100},
		{"id":"519208b3f76769e3","type":"text","text":"監視張睿、誤導調查","x":4090,"y":1469,"width":260,"height":52},
		{"id":"3d6ae93350d9d168","type":"text","text":"會面後數天，張睿接到電話後匆忙離開辦公室，讓秘書通知學生有急事不上課，同日在小巷被槍殺","x":972,"y":60,"width":260,"height":124},
		{"id":"3f06d9a0eb54e87c","type":"text","text":"因財物消失初步判定為隨機劫殺","x":1660,"y":310,"width":260,"height":52},
		{"id":"e504b402d15ce1c8","type":"text","text":"現場附近人跡罕至，沒有目擊者","x":1304,"y":96,"width":260,"height":52},
		{"id":"d04c8d1ba3982068","type":"text","text":"張睿與某人相約見面，之後遭殺害，兇手偽裝成隨機劫殺","x":1660,"y":502,"width":260,"height":76},
		{"id":"4b5279b2101a0ea0","type":"text","text":"報案人為路過的流浪漢","x":1636,"y":96,"width":260,"height":52},
		{"id":"077db597c3210d79","type":"text","text":"案發時三人已離境","x":2940,"y":310,"width":260,"height":52},
		{"id":"1e23cf7cbff4eed3","type":"text","text":"張睿是情報人員，懷疑自己被跟蹤","x":1349,"y":896,"width":260,"height":76},
		{"id":"343bb0b0c6f30592","type":"text","text":"空的公文包，文件實際已交出，張睿是在偽裝準備交收","x":1648,"y":705,"width":260,"height":76},
		{"id":"d9a2d64724101ece","type":"text","text":"約見方出現在小巷滅口","x":1968,"y":96,"width":260,"height":52},
		{"id":"3b25ce6cb56d98d0","type":"text","text":"消失的領帶夾","x":1980,"y":717,"width":260,"height":52},
		{"id":"49ac7b4143df7e08","type":"text","text":"張睿稱是妻子所送","x":1980,"y":908,"width":260,"height":52},
		{"id":"e80c4919f548235f","type":"text","text":"妻子不認得該領帶夾","x":2312,"y":908,"width":260,"height":52},
		{"id":"ff6f3146fdea2e34","type":"text","text":"假秘書所送","x":2146,"y":1111,"width":260,"height":52},
		{"id":"4b99f19b5acad482","type":"text","text":"GPS監控","x":2300,"y":96,"width":260,"height":52},
		{"id":"6ee1da2da83e122b","type":"text","text":"反追蹤","x":2632,"y":96,"width":260,"height":52},
		{"id":"6c54c561973177db","type":"text","text":"引導他們調查教授之死","x":2964,"y":514,"width":260,"height":52},
		{"id":"800802bf748e121f","type":"text","text":"警察懷疑可能受過相關訓練的道爾，但因其身份而謹慎處理","x":984,"y":896,"width":260,"height":76},
		{"id":"5f234c0a63a75b25","type":"text","text":"兇手是假秘書","x":2964,"y":96,"width":260,"height":52},
		{"id":"22898ab378731a2a","type":"text","text":"約見方並未出現在小巷，兇手另有其人","x":1466,"y":1099,"width":260,"height":76},
		{"id":"4cf75c0442b17d85","type":"text","text":"張睿死前與單一號碼多次通話，通話結束的時間點為張睿下車換線或換交通工具前","x":996,"y":490,"width":260,"height":100},
		{"id":"726a70345d6777e5","type":"text","text":"死亡時間在掛上電話後一段時間","x":1328,"y":514,"width":260,"height":52},
		{"id":"35bafa760aa43649","type":"text","text":"約見者有張睿私人電話，不會經秘書聯絡","x":1316,"y":705,"width":260,"height":76},
		{"id":"6f5de0843d4341d2","type":"text","text":"約見方受過反偵察訓練","x":984,"y":717,"width":260,"height":52},
		{"id":"f1e7bf218ce442e5","type":"text","text":"張睿下車後沒有馬上走進巷子，而是在路邊接電話","x":996,"y":298,"width":260,"height":76},
		{"id":"33f7e8e389fa475f","type":"text","text":"落客後至少15分鐘才聽到聲響，但出於怕麻煩未有回頭查看","x":1328,"y":298,"width":260,"height":76}
	],
