{
	"nodes":[
		{"id":"d75ae21741a94d91","type":"group","label":"推論","x":498,"y":702,"width":798,"height":831},
		{"id":"891803f5f7adc05c","type":"group","label":"本質","x":2199,"y":504,"width":308,"height":1458},
		{"id":"15b656be28fbb5d6","type":"group","label":"系統架構","x":2199,"y":77,"width":1288,"height":381},
		{"id":"9590a700eb3a40e9","type":"group","label":"表徵異常","x":8,"y":63,"width":308,"height":1932},
		{"id":"b503d9bb1f55ecce","type":"group","label":"表象","x":1478,"y":564,"width":308,"height":1386},
		{"id":"64da0c7a0931124a","type":"text","text":"**曾為普通人魚**\n\n成為公主前另有一段經歷，曾在別處學習、接觸人類社會","x":522,"y":959,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"a300726ad53345d9","type":"text","text":"**施法被限制**\n\n公主仍保有法力，「無法施法」是外加的限制而非天性","x":522,"y":734,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"d76b256f5bcb6e26","type":"text","text":"**珍珠自行判斷**\n\n判斷在珍珠，不在公主","x":522,"y":1409,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"36af560b3b1fc510","type":"text","text":"**歌曲非女神所賜**\n\n歌曲是人為創作，並非海之女神給予","x":522,"y":1184,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"e18a0ac68f80c601","type":"text","text":"**人魚公主非自然產物**\n\n人魚公主並非天生神使，身份、能力與限制都是後天賦予","x":1012,"y":973,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"5f508397b4ced5dd","type":"text","text":"**基質容器**\n\n基質容器＋干擾粒子製造器，經身體改造與家庭抹除後包裝為神使","x":2223,"y":938,"width":260,"height":148,"color":"#16A34A"},
		{"id":"ddfff15db86ad83b","type":"text","text":"**干擾開關**\n\n變身或使用珍珠時系統暫停干擾","x":2223,"y":1412,"width":260,"height":100,"color":"#16A34A"},
		{"id":"e76892b5accdd47b","type":"text","text":"**干擾粒子**\n\n平常在散播干擾粒子，變身放大釋放","x":2223,"y":1613,"width":260,"height":124,"color":"#16A34A"},
		{"id":"da0804e37663ca90","type":"text","text":"**系統維護者**\n\n長老是系統維護者","x":2223,"y":1838,"width":260,"height":100,"color":"#16A34A"},
		{"id":"224b5a75121eedd1","type":"text","text":"**位置回報**\n\n系統持續回報公主位置","x":2223,"y":536,"width":260,"height":100,"color":"#16A34A"},
		{"id":"3959c320424b3a8a","type":"text","text":"**容器回收**\n\n容器報廢與回收程序","x":2223,"y":737,"width":260,"height":100,"color":"#16A34A"},
		{"id":"f98f65156e846e44","type":"text","text":"**人造輸入曲**\n\n阿拉拉創作、長老輸入系統的人造曲目","x":2223,"y":1187,"width":260,"height":124,"color":"#16A34A"},
		{"id":"cbf0e8d873c80cdb","type":"text","text":"**海之主**\n\n開發星降神臨，用以控制星球防禦系統","x":3203,"y":298,"width":260,"height":124,"color":"#16A34A"},
		{"id":"dfde8498c544cdb9","type":"text","text":"**星降神臨**\n\n星球級系統；核心功能含基質收集、干擾粒子、位置回報與容器回收","x":2713,"y":286,"width":260,"height":148,"color":"#16A34A"},
		{"id":"270f876353487406","type":"text","text":"**海之女神**\n\n系統管理終端的中繼載體","x":2223,"y":334,"width":260,"height":100,"color":"#16A34A"},
		{"id":"066c3977db9fcf4e","type":"text","text":"**珍珠**\n\n系統執行端；離開貝殼時會自動向特定對象釋放能量","x":2223,"y":109,"width":260,"height":124,"color":"#16A34A"},
		{"id":"5186bc0ea43fc2f8","type":"text","text":"**星羅懂得法術基本原理**\n\n印度洋王國禁止公主學習法術，星羅必然在其他地方學過","x":32,"y":1172,"width":260,"height":124,"color":"#2563EB"},
		{"id":"0a939aed345c6821","type":"text","text":"**星羅誕生時已是兒童**\n\n一般公主誕生時都是嬰兒","x":32,"y":971,"width":260,"height":100,"color":"#2563EB"},
		{"id":"e9baaed89451eeb3","type":"text","text":"**星羅認知異於其他公主**\n\n通曉人類語言與社會，對印度洋王國生活印象模糊","x":32,"y":746,"width":260,"height":124,"color":"#2563EB"},
		{"id":"482c117f795e8faa","type":"text","text":"**星羅與Kafziel的特殊連結**\n\n在Kafziel身上找到「哥哥」的感覺","x":32,"y":497,"width":260,"height":148,"color":"#2563EB"},
		{"id":"1c7f7584582c8a41","type":"text","text":"**公主無法使用法術**\n\n王國教導如此，具體原因不明","x":32,"y":296,"width":260,"height":100,"color":"#2563EB"},
		{"id":"08e03da1440c9621","type":"text","text":"**諾愛爾成功強行施放法術**\n\n與「無法施法」的制度說法衝突","x":32,"y":95,"width":260,"height":100,"color":"#2563EB"},
		{"id":"5924591745027934","type":"text","text":"**珍珠指向不受主觀認知影響**\n\n指向對象不受人魚公主主觀認知影響","x":32,"y":1847,"width":260,"height":124,"color":"#2563EB"},
		{"id":"f20632a9cf00907e","type":"text","text":"**歌曲中存在流行曲**\n\n海之女神「給予」的歌曲裡有流行曲","x":32,"y":1397,"width":260,"height":124,"color":"#2563EB"},
		{"id":"6dd844affa5a46d3","type":"text","text":"**歌曲實際由阿拉拉創作**\n\n公主所唱的歌曲實際由阿拉拉創作","x":32,"y":1622,"width":260,"height":124,"color":"#2563EB"},
		{"id":"3032559c5da3a7f9","type":"text","text":"**天降神使**\n\n人魚公主是天降神使","x":1502,"y":998,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"fd0a36fb7b5a856c","type":"text","text":"**歌聲珍珠守護**\n\n公主以歌聲與珍珠守護和平","x":1502,"y":1400,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"ddf27a6e0e6ece7f","type":"text","text":"**感知影響**\n\n公主存在會影響感知、變身能量遠超常人","x":1502,"y":1601,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"24c1de1f91a6dae2","type":"text","text":"**長老輔佐**\n\n長老輔佐並保護公主","x":1502,"y":1826,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"e71f3d2de9495d6c","type":"text","text":"**失蹤無力追查**\n\n公主失蹤是無力追查","x":1502,"y":596,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"e92001a3abe26f4d","type":"text","text":"**星盡神聖處罰**\n\n星盡是違規後的神聖處罰","x":1502,"y":797,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"e64eec9a89f9b63a","type":"text","text":"**女神給予神曲**\n\n歌曲由海之女神「給予」","x":1502,"y":1199,"width":260,"height":100,"color":"#7C3AED"}
	],
