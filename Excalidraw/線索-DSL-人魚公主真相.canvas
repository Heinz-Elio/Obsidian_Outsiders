		{"id":"f2f10d9f58872408","type":"text","text":"海之主開發星降神臨","x":2502,"y":72,"width":260,"height":52,"color":"#EA580C"},
		{"id":"ed83923ddef8e92b","type":"text","text":"星降神臨是星球級系統","x":2502,"y":274,"width":260,"height":52,"color":"#16A34A"},
		{"id":"67927316743fdb48","type":"text","text":"人魚是海之主改造的執行系統載體","x":2170,"y":262,"width":260,"height":76,"color":"#16A34A"},
		{"id":"eaecec5120c58381","type":"text","text":"人魚公主＝儲存基質＋散播干擾粒子＋控制執行端的改造容器","x":2170,"y":478,"width":260,"height":76,"color":"#16A34A"},
		{"id":"ff8018ca60faf2c4","type":"text","text":"珍珠＝執行端","x":2502,"y":490,"width":260,"height":52,"color":"#16A34A"},
		{"id":"a70696071d573c03","type":"text","text":"海之女神＝管理終端的中繼機器","x":3166,"y":490,"width":260,"height":52,"color":"#16A34A"},
		{"id":"32205dd0f8f8a379","type":"text","text":"公主使用珍珠時系統暫停干擾","x":2754,"y":693,"width":260,"height":52,"color":"#EA580C"},
		{"id":"2eb1b70fe18086df","type":"text","text":"系統持續回報公主位置","x":2834,"y":490,"width":260,"height":52,"color":"#EA580C"},
		{"id":"c22c41db47a0dcd1","type":"text","text":"現代長老維護並神聖化制度，但不是原始設計者","x":2793,"y":872,"width":260,"height":76,"color":"#EA580C"},
		{"id":"4ae9030b81692af2","type":"text","text":"身體改造、家庭抹除、無法施法被包裝成神使天生特徵","x":3144,"y":1063,"width":260,"height":76,"color":"#EA580C"},
		{"id":"b6cafab9885f798c","type":"text","text":"阿拉拉創作新歌，由長老輸入系統","x":2422,"y":681,"width":260,"height":76,"color":"#EA580C"},
		{"id":"26cd692159d96506","type":"text","text":"形成「歌聲必勝」與神力表象","x":3125,"y":884,"width":260,"height":52,"color":"#EA580C"},
		{"id":"ae07082620c84547","type":"text","text":"星盡＝容器報廢與回收程序","x":3166,"y":72,"width":260,"height":52,"color":"#EA580C"},
		{"id":"cc9d00bfc9bc083b","type":"text","text":"回收珍珠與身體融合的法術結構","x":2834,"y":274,"width":260,"height":52,"color":"#EA580C"},
		{"id":"68713ed05cd3cf1c","type":"text","text":"容器死亡","x":3498,"y":490,"width":260,"height":52,"color":"#EA580C"},
		{"id":"393ccdbea3011933","type":"text","text":"相關記憶可被抹除","x":3166,"y":274,"width":260,"height":52,"color":"#EA580C"},
		{"id":"b9397f60113e9ee6","type":"text","text":"以繼承者取代","x":3498,"y":274,"width":260,"height":52,"color":"#EA580C"},
		{"id":"221ac3233801fdf0","type":"text","text":"星羅在人類社會長大，人魚公主並非自然誕生","x":2170,"y":60,"width":260,"height":76,"color":"#2563EB"},
		{"id":"6afde9389f28a6d9","type":"text","text":"沙羅情緒崩潰是近因，系統連接異常把失控放大為滅國","x":3498,"y":60,"width":260,"height":76,"color":"#EA580C"},
		{"id":"df0a8e62e74e52dd","type":"text","text":"女神選出天生神使","x":3814,"y":1254,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"3a6c9092d1abc714","type":"text","text":"公主以歌聲與珍珠守護和平","x":4146,"y":1075,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"f4065c266e855c31","type":"text","text":"長老輔佐並保護公主","x":3814,"y":1075,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"7d8715b5f4a4ca92","type":"text","text":"公主失蹤是無力追查","x":3814,"y":693,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"20b9b74b6ef5d197","type":"text","text":"星盡是違規後的神聖處罰","x":3830,"y":274,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"3f35f24ea149843d","type":"text","text":"星羅懂得法術的基本原理，但印度洋王國禁止人魚公主學習法術","x":1028,"y":262,"width":260,"height":76,"color":"#2563EB"},
		{"id":"ba2eec812dc53c3c","type":"text","text":"存在「成為人魚公主前」的階段","x":1231,"y":490,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"00622133ed6dc947","type":"text","text":"人魚公主原本是普通人魚","x":1129,"y":693,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"645fd5054c9c3aef","type":"text","text":"人魚公主會影響感知","x":32,"y":72,"width":260,"height":52,"color":"#2563EB"},
		{"id":"9ab234f97e730673","type":"text","text":"變身後人魚公主會大量釋放能量","x":32,"y":274,"width":260,"height":52,"color":"#2563EB"},
		{"id":"062c8ea674583e72","type":"text","text":"珍珠釋放的能量具有指向性，但指向對象不受人魚公主主觀認知影響","x":235,"y":466,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"e18a0ac68f80c601","type":"text","text":"人魚公主非自然產物","x":1028,"y":884,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"943adc2630143715","type":"text","text":"人魚公主經過改造","x":862,"y":1075,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"e1d933ed7a820153","type":"text","text":"人魚公主無法使用法術，具體原因不明","x":364,"y":262,"width":260,"height":76,"color":"#2563EB"},
		{"id":"08e03da1440c9621","type":"text","text":"諾愛爾成功強行施放法術","x":696,"y":274,"width":260,"height":52,"color":"#2563EB"},
		{"id":"52b5e04d0e4a0262","type":"text","text":"人魚公主擁有法力系統","x":899,"y":490,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"386020411f3ae3b6","type":"text","text":"人魚公主是某種開關","x":32,"y":884,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"126fe6e400c84d1a","type":"text","text":"一般海之住民沒有如此龐大的法力量","x":696,"y":872,"width":260,"height":76,"color":"#7C3AED"},
		{"id":"4d867345a7a88ae5","type":"text","text":"星羅誕生時已是兒童，但其他人誕生時都是嬰兒","x":1360,"y":262,"width":260,"height":76,"color":"#2563EB"},
		{"id":"d16fe7f7a4c7bf4e","type":"text","text":"星羅在里昂身上找到「哥哥」的感覺","x":1563,"y":478,"width":260,"height":76,"color":"#2563EB"},
		{"id":"f7726cc34cec8f75","type":"text","text":"判斷指向對象、釋放能量的是珍珠","x":364,"y":681,"width":260,"height":76,"color":"#7C3AED"},
		{"id":"d6d48b9b4153dfd4","type":"text","text":"人魚公主平常在干擾珍珠判斷","x":364,"y":884,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"c10038b9db534344","type":"text","text":"珍珠離開貝殼時會自動向特定對象釋放能量","x":567,"y":478,"width":260,"height":76,"color":"#2563EB"},
		{"id":"a4bb880b8cc75d89","type":"text","text":"星羅會人類的語言，對人類社會的認識遠超海底世界，而且對印度洋王國的生活印象模糊","x":1692,"y":250,"width":260,"height":100,"color":"#2563EB"},
		{"id":"882fb0bd1bef8fea","type":"text","text":"海之女神「給予」的歌曲中存在流行曲","x":1360,"y":872,"width":260,"height":76,"color":"#2563EB"},
		{"id":"ceaff77e6e95f60e","type":"text","text":"長老在背後控制","x":1692,"y":1075,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"b0ecff941a3d7a15","type":"text","text":"變身影響能量釋放","x":32,"y":693,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"5287e61794c62478","type":"text","text":"人魚公主所唱的歌曲實際由阿拉拉創作","x":1692,"y":872,"width":260,"height":76,"color":"#2563EB"},
		{"id":"ee0f8e26719df080","type":"text","text":"終端機、弗拉基米爾、米迦勒事先知道星羅誕生日期及地點","x":4462,"y":478,"width":260,"height":76,"color":"#64748B"},
		{"id":"dde0fac8dd64a918","type":"text","text":"常藍內部實例只能解釋既有公主的陸地行蹤","x":4794,"y":478,"width":260,"height":76,"color":"#64748B"},
		{"id":"0a815337a5ff96ae","type":"text","text":"烏蘇拉協助綁架星羅並干擾追蹤，但誕生情報來源未明","x":5126,"y":478,"width":260,"height":76,"color":"#64748B"},
		{"id":"959e28f798d0cbf5","type":"text","text":"星羅誕生情報鏈未閉合\n\n`補丁`","x":4628,"y":693,"width":260,"height":52,"color":"#64748B"},
		{"id":"924466d48e85161c","type":"text","text":"4月5至6日 VPTS 攔截與米迦勒襲擊是否同源\n\n`補丁`","x":4628,"y":872,"width":260,"height":76,"color":"#64748B"}
	],
