{
	"nodes":[
		{"id":"d75ae21741a94d91","type":"group","label":"串連假設（原 SVG 推理，正文未證實）","x":8,"y":1802,"width":500,"height":4916},
		{"id":"891803f5f7adc05c","type":"group","label":"事件","x":2564,"y":46,"width":698,"height":4976},
		{"id":"15b656be28fbb5d6","type":"group","label":"為何送來沙羅？","x":516,"y":70,"width":1868,"height":3208},
		{"id":"9590a700eb3a40e9","type":"group","label":"米迦勒是誰？","x":7628,"y":1790,"width":1868,"height":1052},
		{"id":"b503d9bb1f55ecce","type":"group","label":"誰僱用傭兵？","x":3270,"y":3098,"width":1478,"height":2748},
		{"id":"83a056d93f512c5f","type":"group","label":"誰在協助V？","x":3270,"y":46,"width":1868,"height":1464},
		{"id":"6eca50fefd90742f","type":"group","label":"誰洩漏了誕生情報？","x":9840,"y":1802,"width":698,"height":1064},
		{"id":"a19268416bb74cc2","type":"group","label":"謎題指向甚麼？","x":5230,"y":482,"width":2390,"height":1500},
		{"id":"ec8b917cfe9e19d1","type":"text","text":"**引導介入**\n\nV 引導游騎士介入，是為了讓彭達拉薩人出現在人魚面前","x":187,"y":3130,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"da36bfe65c5e503f","type":"text","text":"**V委託**\n\nV 是傭兵的真正委託人；只有 V 知道公主必經印度回國","x":224,"y":6110,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"ef1324b600fff585","type":"text","text":"**時限重疊**\n\n寄存櫃 4/6 時限迫使 Kafziel 一方經印度，與傭兵搜索時空重疊","x":224,"y":3542,"width":260,"height":148,"color":"#7C3AED"},
		{"id":"0b2b66caea0a3207","type":"text","text":"**沙羅角色**\n\n沙羅是 V 賦予的翻譯與解讀者角色","x":224,"y":1834,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"1e08eaad62a8ea0d","type":"text","text":"**委託矛盾**\n\nV 若是委託人，為何同時引導 Kafziel 破壞綁架（劇本需要衝突，或藉此測試 SWI）","x":128,"y":6522,"width":260,"height":172,"color":"#DC2626"},
		{"id":"4dcbb36f016222fb","type":"text","text":"**第一封信**\n\nV經Glove留在公園的錨點送來只裝著一張合照的信封","x":2978,"y":526,"width":260,"height":124,"color":"#EA580C"},
		{"id":"70a8530a02c8a438","type":"text","text":"**孤兒院調查**\n\nKafziel與 Acer調查廢棄孤兒院","x":2978,"y":1398,"width":260,"height":124,"color":"#EA580C"},
		{"id":"ea4b9bdf302ef905","type":"text","text":"**孤兒院火災倖存者**\n\n三名倖存者被領養後改名，公開紀錄查不到下落，堂本薰是倖存者之一","x":2904,"y":78,"width":260,"height":148,"color":"#EA580C"},
		{"id":"0c0956784dbc968b","type":"text","text":"星羅誕生","x":2588,"y":2306,"width":260,"height":52,"color":"#EA580C"},
		{"id":"defb10ad7c0cfff7","type":"text","text":"**米迦勒襲擊**\n\n米迦勒與水妖襲擊","x":2978,"y":2282,"width":260,"height":100,"color":"#EA580C"},
		{"id":"83e01dcc29e3f660","type":"text","text":"**救援**\n\nKafziel介入救援","x":2978,"y":2718,"width":260,"height":100,"color":"#EA580C"},
		{"id":"85f876bb97a83b56","type":"text","text":"**印度搜索**\n\n傭兵在印度搜索星羅，被 Kafziel 一方捷足先登（第一次行動失敗）","x":2978,"y":3542,"width":260,"height":148,"color":"#EA580C"},
		{"id":"2ed0242a2d467bb6","type":"text","text":"**後備計劃**\n\n傭兵啟動後備計劃，以七位人魚公主為目標並展開監視","x":2778,"y":3978,"width":260,"height":124,"color":"#EA580C"},
		{"id":"15ee2190664e13f8","type":"text","text":"**魁北克綁架**\n\n兩支傭兵小隊夜襲哈佛聖皮埃爾小屋，注射鎮靜劑帶走諾愛爾與可伶","x":2904,"y":4390,"width":260,"height":148,"color":"#EA580C"},
		{"id":"33e66ba4fff6614f","type":"text","text":"**攔截**\n\nKafziel、Soar 冒充傭兵擊殺 A 隊，B 隊清除狙擊手，並拉上可可安撫兩人","x":2978,"y":4826,"width":260,"height":172,"color":"#EA580C"},
		{"id":"547b6a15ae3a77dc","type":"text","text":"**第三方**\n\n第三方隱匿人員持步槍逼近，意圖殺人，被擊殺","x":2588,"y":4850,"width":260,"height":124,"color":"#EA580C"},
		{"id":"fb1934b890f2330e","type":"text","text":"**沙羅身體乾淨**\n\n無海水、泥土痕跡","x":1320,"y":102,"width":260,"height":100,"color":"#2563EB"},
		{"id":"18dcad19fcfdb5d4","type":"text","text":"**替沙羅清洗**\n\nV曾替沙羅清洗更衣或貝現身體","x":1320,"y":538,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"c084b8e1028acc4a","type":"text","text":"阿奎斯托語詩文","x":1320,"y":998,"width":260,"height":52,"color":"#2563EB"},
		{"id":"b766311304ad044a","type":"text","text":"**寄存收據**\n\n印度車站行李寄存收據，截止日由2月10日塗改為4月6日晚","x":577,"y":3130,"width":260,"height":124,"color":"#2563EB"},
		{"id":"9883a1dbab2ff628","type":"text","text":"V懂阿奎斯托語","x":1710,"y":1434,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"d2fcd87e61d787f9","type":"text","text":"V知道沙羅是前公主","x":2100,"y":1434,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"69fcb0d0759cfe7c","type":"text","text":"**對象沙羅**\n\n收信對象是沙羅","x":540,"y":1410,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"8092c9072eabc91f","type":"text","text":"**導演劇本**\n\nV 自視為導演，要把「已殺青」的沙羅抓回舞台；「擊穿堡壘」不會只是重演侵略","x":930,"y":1386,"width":260,"height":148,"color":"#7C3AED"},
		{"id":"c03a15227daa5309","type":"text","text":"**V曾在IU7**\n\nV曾在IU7生活甚至在IU7出生","x":1320,"y":1398,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"28e5997ad2559780","type":"text","text":"**標準日語**\n\n米迦勒自稱「阿奎斯托的王」，卻對人魚公主說標準日語","x":8432,"y":1834,"width":260,"height":124,"color":"#2563EB"},
		{"id":"63b6589de5fbd20f","type":"text","text":"**空間篩選**\n\n空間只拉入生物與誓約之泉，術式有特定作用對象且刻意","x":7652,"y":1834,"width":260,"height":124,"color":"#2563EB"},
		{"id":"ae26733be3e162e2","type":"text","text":"**AS-1079**\n\n米迦勒空間與廢墟之下的大量修正力同源，但米迦勒不是游離者","x":8822,"y":1834,"width":260,"height":124,"color":"#2563EB"},
		{"id":"1bbee848412b6cb6","type":"text","text":"**舒華澤**\n\n米迦勒稱Kafziel為「倫道爾的舒華澤」、「彭達拉薩人」","x":9212,"y":1822,"width":260,"height":148,"color":"#2563EB"},
		{"id":"0514ec7c8a932b1c","type":"text","text":"**撤退**\n\n米迦勒得手失敗後主動撤退","x":8042,"y":1846,"width":260,"height":100,"color":"#2563EB"},
		{"id":"0cdbc487c7e98c9a","type":"text","text":"**術式主體**\n\n米迦勒不是游離者，只是修正力術式的作用主體","x":8432,"y":2270,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"041250ebdd86aa5a","type":"text","text":"**曾接觸**\n\nKafziel 曾與米迦勒接觸並拒絕邀請，或米迦勒認錯了人","x":9212,"y":2258,"width":260,"height":148,"color":"#7C3AED"},
		{"id":"0da27f2708214daa","type":"text","text":"**復活**\n\n詩詩與美美的復活是米迦勒所為\n\n`採信`","x":7652,"y":2718,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"9730cefd9ab57a58","type":"text","text":"**未知游離者**\n\nAS-1079 是誰；是否主動參與；與米迦勒、V 的關係","x":8822,"y":2270,"width":260,"height":124,"color":"#64748B"},
		{"id":"630c030534d6fe23","type":"text","text":"**經印度**\n\n沙羅能直接傳送，為何要露芝亞經印度陸路回國","x":3294,"y":3130,"width":260,"height":124,"color":"#64748B"},
		{"id":"91d78f6a54bebf6c","type":"text","text":"**傭兵特徵**\n\n傭兵無隊伍標識，用北美流通槍械，行動模式屬前駐軍","x":4210,"y":3978,"width":260,"height":124,"color":"#2563EB"},
		{"id":"ec74ec5495483bda","type":"text","text":"**上層判斷**\n\n上層堅持派兩隊，並傾向把上次失敗歸為人為失誤","x":3430,"y":3978,"width":260,"height":124,"color":"#2563EB"},
		{"id":"0f5dec87be5695ff","type":"text","text":"**不同頻道**\n\n第三方使用不同無線電頻道，資料庫無此人紀錄","x":3294,"y":4402,"width":260,"height":124,"color":"#2563EB"},
		{"id":"04c53200d8ffea69","type":"text","text":"**行李袋文件**\n\n所有公主的情報、監視紀錄、行動計劃與事後報告，金澤同事已核實","x":3684,"y":4390,"width":260,"height":148,"color":"#2563EB"},
		{"id":"b5a9b9787dafcb7b","type":"text","text":"**入境監視**\n\n諾愛爾與可伶幾乎在入境當刻就被監視","x":4074,"y":4402,"width":260,"height":124,"color":"#2563EB"},
		{"id":"1425ca7e7aea5d59","type":"text","text":"**鎮靜劑**\n\n鎮靜劑對人魚提早失效","x":3820,"y":3990,"width":260,"height":100,"color":"#2563EB"},
		{"id":"f7fc546c8ed65052","type":"text","text":"**三方混戰**\n\n第三方與要活口的傭兵不是一夥，局面至少是三方混戰\n\n`採信`","x":3377,"y":5286,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"274adf29cc6a9e45","type":"text","text":"**委託動機**\n\n委託人知道公主的真實身分，否則沒有委託動機","x":3920,"y":5286,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"00086b8eca1c40a1","type":"text","text":"**行蹤情報**\n\n傭兵背後有掌握所有公主行蹤的情報源","x":3997,"y":4850,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"dbd32b7f7182abe5","type":"text","text":"**僱主**\n\n傭兵真正僱主；「寶物」的吸引力；與 V 的關係","x":3377,"y":5699,"width":260,"height":124,"color":"#64748B"},
		{"id":"669d4d74e7160da7","type":"text","text":"**星羅情報**\n\n傭兵為何知道星羅存在","x":4464,"y":4414,"width":260,"height":100,"color":"#64748B"},
		{"id":"a3bf8a192f3dd70d","type":"text","text":"**孤兒院合照**\n\n被燒掉一角，至少三十年歷史，但保存狀況良好","x":4854,"y":90,"width":260,"height":124,"color":"#2563EB"},
		{"id":"257c273497b84b05","type":"text","text":"**背面日期**\n\n照片背面「檀香山，2004-2-25」為V筆跡，書寫時間約在送信前十天","x":3294,"y":78,"width":260,"height":148,"color":"#2563EB"},
		{"id":"aec684bfac3ade01","type":"text","text":"**信封封蠟**\n\n成份常見，圖案是獨特的十字變體，表面不平整且缺角","x":3684,"y":90,"width":260,"height":124,"color":"#2563EB"},
		{"id":"28977cd48c3c3f5e","type":"text","text":"**封蠟相同**\n\n封蠟樣式與第一封信相同","x":4074,"y":102,"width":260,"height":100,"color":"#2563EB"},
		{"id":"665408f998bc9d83","type":"text","text":"**倖存者帶出**\n\n合照由倖存者帶出火場保存","x":3684,"y":538,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"3c1fb460d3c4da1c","type":"text","text":"**V控制倖存者**\n\nV控制了倖存者之一或其身邊人","x":4602,"y":974,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"17907936847c5980","type":"text","text":"**新手封蠟**\n\n封蠟者可能是新手","x":4074,"y":538,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"5824cde2dcf91f37","type":"text","text":"**現場痕跡極少**\n\n登山靴鞋印與綠色人造纖維沒有指向性","x":3822,"y":962,"width":260,"height":124,"color":"#2563EB"},
		{"id":"71658082f90cb6ea","type":"text","text":"**動作俐落**\n\n腳印動線只有窗前、鐵櫃前、牆前三個停留點","x":4212,"y":962,"width":260,"height":124,"color":"#2563EB"},
		{"id":"b66a74e740cea8a0","type":"text","text":"**地板洞口**\n\n洞口木屑顯示是火災後鑽開","x":3432,"y":974,"width":260,"height":100,"color":"#2563EB"},
		{"id":"c7e168fd72b28e90","type":"text","text":"專業執行者","x":4017,"y":1434,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"7f797d6cbdf03a73","type":"text","text":"**Glove的傳送錨點**\n\n貝殼下一美分硬幣，外覆圓柱狀APCS","x":4464,"y":90,"width":260,"height":124,"color":"#2563EB"},
		{"id":"8e8db1d8ea2d3042","type":"text","text":"**Glove合作**\n\nGlove與V不是一次性合作","x":4464,"y":538,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"2432b6167e670fb8","type":"text","text":"**沙羅不知日期**\n\n沙羅不知道新任公主的確切誕生日期","x":9864,"y":2270,"width":260,"height":124,"color":"#2563EB"},
		{"id":"dff471a52300e9f6","type":"text","text":"**沙羅委託**\n\n沙羅事前委託 Kafziel 救人，卻只向露芝亞提星羅的事","x":9864,"y":1834,"width":260,"height":124,"color":"#2563EB"},
		{"id":"e3529df1c8e61033","type":"text","text":"**沙羅在陸地**\n\n沙羅事後以電話聯絡露芝亞","x":10254,"y":1846,"width":260,"height":100,"color":"#2563EB"},
		{"id":"52524c82b0efcbd0","type":"text","text":"**沙羅預知**\n\n沙羅事先知道米迦勒會出現","x":10254,"y":2282,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"65c01b4b161c06e6","type":"text","text":"**情報鏈**\n\n米迦勒的情報來源是誰；V 是情報鏈一環還是想利用事件的第三方","x":9864,"y":2694,"width":260,"height":148,"color":"#64748B"},
		{"id":"af0cf449421849c6","type":"text","text":"**壁畫Hangman題目**\n\n橙色字","x":5254,"y":974,"width":260,"height":100,"color":"#2563EB"},
		{"id":"b45eae27aa314d91","type":"text","text":"**V的特殊字體**\n\n字母寫法刻意強調 v，此前只在V的挑釁訊息中出現","x":5644,"y":526,"width":260,"height":124,"color":"#2563EB"},
		{"id":"800f236c6ed025b9","type":"text","text":"**畫者身高**\n\n由畫的頂端高度推估畫者身高1.75至1.85米","x":5254,"y":526,"width":260,"height":124,"color":"#2563EB"},
		{"id":"23965e70281ad2b3","type":"text","text":"**答題系統**\n\n字母積木與藍色盒子，帶特殊能量，Hangman題目的答題系統","x":5644,"y":950,"width":260,"height":148,"color":"#2563EB"},
		{"id":"edab73ff6004cd7c","type":"text","text":"**Hangman答案**\n\nHangman題目答案：4月5日 19:00","x":6424,"y":1398,"width":260,"height":124,"color":"#2563EB"},
		{"id":"343aece80ca9fab3","type":"text","text":"**地下室圓陣**\n\n橙色七芒星，粉、黃圓珠缺失","x":6424,"y":974,"width":260,"height":100,"color":"#2563EB"},
		{"id":"1a7ca90843a13d74","type":"text","text":"**圓陣與人魚王國集團**\n\n七個王國的代表色、方位與圓珠大致對應","x":6814,"y":962,"width":260,"height":124,"color":"#2563EB"},
		{"id":"3c0235d5c305592b","type":"text","text":"**圓陣代表人魚王國**\n\n橙色圓珠代表印度洋王國，北太平洋王國、南太平洋王國缺失","x":6814,"y":1398,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"370fdff2e0718b2e","type":"text","text":"V偏好紅色","x":6034,"y":998,"width":260,"height":52,"color":"#2563EB"},
		{"id":"4cb8d5668240bd40","type":"text","text":"V刻意用橙色配合沙羅","x":6034,"y":1434,"width":260,"height":52,"color":"#7C3AED"},
		{"id":"0676e1932b7e6d36","type":"text","text":"**孤兒象徵人魚公主**\n\n人魚公主沒有生理父母，形同孤兒","x":7336,"y":526,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"e372d1b0c62db8f5","type":"text","text":"**處刑**\n\nExecute","x":5254,"y":1410,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"237528aabdcebb14","type":"text","text":"**紅色戲票**\n\n時地與Hangman題目相同","x":7336,"y":1410,"width":260,"height":100,"color":"#2563EB"},
		{"id":"999b93c4c11e976e","type":"text","text":"**誕生推論**\n\n戲票時地指向新任人魚公主誕生","x":6568,"y":1846,"width":260,"height":100,"color":"#7C3AED"},
		{"id":"5af27b649ca2165f","type":"text","text":"**參演**\n\n戲票是要他們「參演」而非「觀賞」","x":5857,"y":1834,"width":260,"height":124,"color":"#7C3AED"},
		{"id":"2cb42427e84fd3de","type":"text","text":"**藍色盒子**\n\n內有不導電但對法力反應的類電路板，量產工業品，含未知合金與稀土","x":6295,"y":514,"width":260,"height":148,"color":"#2563EB"},
		{"id":"81314191e2f74a1c","type":"text","text":"**沙羅未見盒子**\n\n沙羅從未見過藍色盒子或同類物品","x":6946,"y":526,"width":260,"height":124,"color":"#2563EB"},
		{"id":"e2ce45b5d1a30dde","type":"text","text":"**板材供應鏈**\n\n類電路板的供應鏈 板材來源","x":7204,"y":974,"width":260,"height":100,"color":"#64748B"}
	],
