		{"id":"ffc8f1e0161d7ef0","type":"text","text":"壁畫 Hangman：Execute at ＿＿＿＿＿ ＿＿＿＿＿ 19:00，橙色","x":1086,"y":705,"width":260,"height":100,"color":"#2563EB"},
